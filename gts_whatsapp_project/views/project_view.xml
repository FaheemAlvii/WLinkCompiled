<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_project_task_form_whatsapp_id" model="ir.ui.view">
            <field name="name">project.task.whatsapp.form</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button
                            name="whatsapp_template_message"
                            type="object"
                            icon="fa-whatsapp"
                            string=" Send By WhatsApp"
                            class="btn-primary"
                            groups="gts_whatsapp.group_gts_manager"
                            title="Send By WhatsApp"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>