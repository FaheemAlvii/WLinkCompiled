<odoo>
    <record id="view_whatsapp_campaign_tree_tree" model="ir.ui.view">
        <field name="name">whatsapp.campaign.tree.tree</field>
        <field name="model">whatsapp.campaign.list</field>
        <field name="arch" type="xml">
            <tree string="Campaign Lists">
                <field name="name"/>
                <field name="description"/>
                <field name="contact_count"/>
            </tree>
        </field>
    </record>

    <record id="view_whatsapp_campaign_tree_form" model="ir.ui.view">
        <field name="name">whatsapp.campaign.tree.form</field>
        <field name="model">whatsapp.campaign.list</field>
        <field name="arch" type="xml">
            <form string="Campaign tree">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="contact_ids" widget="many2many"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_campaign_tree" model="ir.actions.act_window">
        <field name="name">Campaign Lists</field>
        <field name="res_model">whatsapp.campaign.list</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>Create and manage Lists of contacts for targeted WhatsApp marketing campaigns.</p>
        </field>
    </record>
</odoo> 