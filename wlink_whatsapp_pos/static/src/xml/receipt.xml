<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="wlink_whatsapp_pos.ReceiptScreen" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//form[hasclass('send-email')]" position="after">

            <!-- Receipt Sending Form -->
            <form class="mt-1 send-whatsapp">
                <div class="input-whatsapp" t-on-submit.prevent="onSendWhatsapp">
                    <input type="tel" class="input-email" placeholder="Whatsapp: Receipt"
                           t-model="state.inputWhatsapp" t-on-input="onInputWhatsapp"/>
                    <button class="send highlight" t-on-click="onSendWhatsapp"
                            t-att-disabled="state.isSending || state.whatsappButtonDisabled" type="submit">
                        <i class="fa"
                           t-att-class="state.isSending ? 'fa-fw fa-spin fa-circle-o-notch' : 'fa-solid fa-whatsapp'"
                           aria-hidden="true"/>
                        Send Receipt
                    </button>
                </div>
            </form>

            <!-- Invoice Sending Form -->
            <form class="mt-1 send-whatsapp" t-if="currentOrder.is_to_invoice()">
                <div class="input-whatsapp" t-on-submit.prevent="onSendInvoiceWhatsapp">
                    <input type="tel" class="input-email" placeholder="Whatsapp: Invoice"
                           t-model="state.inputWhatsapp" t-on-input="onInputWhatsapp"/>
                    <button class="send highlight" t-on-click="onSendInvoiceWhatsapp"
                            t-att-disabled="state.isInvoiceSending || state.whatsappButtonDisabled" type="submit">
                        <i class="fa"
                           t-att-class="state.isInvoiceSending ? 'fa-fw fa-spin fa-circle-o-notch' : 'fa-solid fa-whatsapp'"
                           aria-hidden="true"/>
                        Send Invoice
                    </button>
                </div>
            </form>

            <!-- Message Input -->
            <div>
                <p style="margin: 7px; font-size: 12px;">Enter your message.</p>
            </div>
            <div>
                <textarea style="box-shadow: 0px 0px 0px 1px gainsboro inset !important; border-radius: 0 !important;"
                          id="input_whatsapp" rows="2" cols="100" placeholder="Message"
                          t-model="state.inputMessage" t-ref="input" name="note"></textarea>
            </div>

        </xpath>
    </t>
</templates>
