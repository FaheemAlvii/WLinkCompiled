<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="wlink_whatsapp_repair_order_form">
        <field name="name">wlink.whatsapp.repair.order</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"></field>
        <field name="arch" type="xml">
            <xpath expr="//form/header/button[@name='action_validate']" position="after">
                <button string="Send By Whatsapp" icon="fa-whatsapp" name="whatsapp_template_message" groups="wlink_whatsapp.group_wlink_manager" type="object"/>
                <button string="Message" icon="fa-whatsapp" name="whatsapp_direct_message" groups="wlink_whatsapp.group_wlink_manager" type="object"/>
            </xpath>
        </field>
    </record>
</odoo>